#include <bits/stdc++.h>
using namespace std;

typedef long long ll;
typedef pair<int, int> pii;
typedef vector<int> vi;

#define pb push_back
#define f first
#define s second
#define all(x) x.begin(),x.end()
#define rep(i,a,b) for(int i=a;i<b;i++)

void solve() {
    int n, k;
    ll m;
    cin >> n >> k >> m;

    if (k > m) {
        cout << "NO\n";
        return;
    }

    cout << "YES\n";

    if (m == 1) {
        rep(i,0,n) cout << 1 << " ";
        cout << "\n";
        return;
    }

    rep(i,1,n+1) {
        if (i % k == 0)
            cout << (m - k + 1);
        else
            cout << 1;

        if (i != n) cout << " ";
    }
    cout << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;

    while (t--)
        solve();

    return 0;
}
